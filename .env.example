# Copy to .env and fill with your Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Firestore database id. Leave blank for '(default)'. Set to 'il' after migrating
# data to me-west1 (Tel Aviv) — see docs/firestore-israel-migration.md.
VITE_FIRESTORE_DB_ID=

# Set to true to use localStorage instead of Firebase (dev / demo)
VITE_USE_LOCAL_DATA=true

# Receipt archive (Google Apps Script) — see automation/receipts-archive.gs.
# When set, each issued receipt is backed up as a PDF to a per-month Drive
# folder and logged in a Sheet. Leave blank to disable.
VITE_ARCHIVE_WEBAPP_URL=
VITE_ARCHIVE_TOKEN=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Profile document (displayName, email, fcmTokens, business).
      allow read, write: if isOwner();

      match /studios/{id} {
        allow read, write: if isOwner();
      }
      match /lessons/{id} {
        allow read, write: if isOwner();
      }
      match /hourEntries/{id} {
        allow read, write: if isOwner();
      }
      match /payments/{id} {
        allow read, write: if isOwner();
      }
      match /counters/{id} {
        allow read, write: if isOwner();
      }

      // Financial documents are sequentially numbered and form a קובץ קבוע:
      // create + read; the sole permitted update is issued -> cancelled
      // (number and type must not change). Records are NEVER deleted — an
      // invoice/demand is voided in place via the same status transition.
      match /documents/{id} {
        allow read, create: if isOwner();
        // Two permitted updates only:
        //  (a) void: issued -> cancelled, number & type unchanged.
        //  (b) stamp originalPrintedAt exactly once, changing nothing else.
        allow update: if isOwner() && (
          (
            resource.data.status == 'issued'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.number == resource.data.number
            && request.resource.data.type == resource.data.type
          ) || (
            resource.data.originalPrintedAt == null
            && request.resource.data.originalPrintedAt is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originalPrintedAt'])
          )
        );
        allow delete: if false;
      }
    }
  }
}
